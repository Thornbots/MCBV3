{
    // MCBV3 as the Isaac ROS workspace's firmware/MCBV3 submodule (Linux host).
    // Mounts the workspace at its host path so core.hooksPath and the policy
    // hooks (docs/CI.md#repository-policy) resolve, and ~/.ssh read-only so
    // ssh commit signing works. Keep the rest in sync with ../devcontainer.json.
    "name": "MCBV3 (Isaac ROS workspace)",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    "workspaceMount": "source=${localWorkspaceFolder}/../..,target=${localWorkspaceFolder}/../..,type=bind",
    "workspaceFolder": "${localWorkspaceFolder}",
    "runArgs": [
        "--device-cgroup-rule=c 189:* rmw",
        "-v", "/dev/bus/usb:/dev/bus/usb"
    ],
    "remoteUser": "ubuntu",
    "postCreateCommand": "cd MCB-project && pipenv install",
    "customizations": {
        "vscode": {
            "extensions": [
                "marus25.cortex-debug",
                "ms-vscode.cpptools",
                "aruwrobotchooser.robot-chooser"
            ],
            "settings": {
                "cortex-debug.gdbPath": "gdb-multiarch"
            }
        }
    },
    "mounts": [
        "source=MCB-extensions-ubuntu,target=/home/ubuntu/.vscode-server/extensions,type=volume",
        "source=${localEnv:HOME}/.ssh,target=${localEnv:HOME}/.ssh,type=bind,readonly"
    ]
}
