{
    // Standalone clone. Inside the Isaac ROS workspace, pick isaac-ros-workspace
    // instead: it adds workspace policy hooks and commit signing.
    "name": "MCBV3",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // Flashing needs the CMSIS-DAP probe: share host USB (major 189) with hotplug.
    "runArgs": [
        "--device-cgroup-rule=c 189:* rmw",
        "-v", "/dev/bus/usb:/dev/bus/usb"
    ],
    // Non-root, remapped to the host UID, so build output and .git stay host-owned.
    "remoteUser": "ubuntu",
    // Hosts that cannot remap the UID (Docker Desktop) still show the checkout
    // as foreign-owned; git refuses it as "dubious ownership" without this.
    "containerEnv": {
        "GIT_CONFIG_COUNT": "1",
        "GIT_CONFIG_KEY_0": "safe.directory",
        "GIT_CONFIG_VALUE_0": "*"
    },
    "postCreateCommand": "cd MCB-project && pipenv install",
    "customizations": {
        "vscode": {
            "extensions": [
                "marus25.cortex-debug",
                "ms-vscode.cpptools",
                "aruwrobotchooser.robot-chooser"
            ],
            "settings": {
                "cortex-debug.gdbPath": "gdb-multiarch"
            }
        }
    },
    "mounts": [
        // Persist installed extensions across container rebuilds
        "source=MCB-extensions-ubuntu,target=/home/ubuntu/.vscode-server/extensions,type=volume"
    ]
}
