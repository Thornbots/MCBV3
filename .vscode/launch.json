{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Tests",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build Tests - Debug",
      "program": "${workspaceFolder}/MCB-project/build/tests/scons-debug/MCB-project-tests.elf",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug Sim",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build Sim - Debug",
      "program": "${workspaceFolder}/MCB-project/build/sim/scons-debug/MCB-project.elf",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      // Builds the debug profile for the robot selected as the C/C++
      // configuration, flashes it over the CMSIS-DAP probe and stops at main.
      "name": "Debug Hardware",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build - Debug",
      "executable": "${workspaceFolder}/MCB-project/build/hardware/scons-debug/MCB-project.elf",
      "device": "STM32F407IG",
      "configFiles": ["${workspaceFolder}/MCB-project/openocd.cfg"],
      "runToEntryPoint": "main"
    },
    {
      // Attaches to firmware already running on the board without flashing.
      // Only valid when the board runs the build in "executable".
      "name": "Attach Hardware",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/MCB-project/build/hardware/scons-debug/MCB-project.elf",
      "device": "STM32F407IG",
      "configFiles": ["${workspaceFolder}/MCB-project/openocd.cfg"]
    }
  ]
}
