{
  "editor.tabSize": 4,
  "files.associations": {
    "SConstruct": "python",
    "SConscript": "python",
    "*.source": "cpp"
  },
  "files.exclude": {
    ".gitignore": true,
    "COPYING": true,
    "isolated-deploy": true,
    "MCB-project/build": true,
    "MCB-project/.sconsign.dblite": true,
    "MCB-project/openocd.cfg": true,
    "MCB-project/Pipfile": true,
    "MCB-project/Pipfile.lock": true
  },
  "C_Cpp.errorSquiggles": "Enabled",
  "C_Cpp.default.includePath": [
    "MCB-project/taproot/src",
    "MCB-project/src"
  ],
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.forcedInclude": [
    "MCB-project/robot-type/robot_type.hpp"
  ],
  "[markdown]": {
    "editor.wordWrap": "off",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.rulers": [
      100
    ]
  }
}
